digraph "cmos_demo" {
label="cmos_demo";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="y[1]", color="black", fontcolor="black"];
n3 [ shape=octagon, label="y[0]", color="black", fontcolor="black"];
n5 [ shape=octagon, label="a", color="black", fontcolor="black"];
n6 [ shape=octagon, label="b", color="black", fontcolor="black"];
c10 [ shape=record, label="{{<p8> A}|$0\nNOT|{<p9> Y}}",  ];
c11 [ shape=record, label="{{<p8> A}|$1\nNOT|{<p9> Y}}",  ];
c13 [ shape=record, label="{{<p8> A|<p12> B}|$2\nNOR|{<p9> Y}}",  ];
c14 [ shape=record, label="{{<p8> A|<p12> B}|$3\nNOR|{<p9> Y}}",  ];
c15 [ shape=record, label="{{<p8> A|<p12> B}|$4\nNOR|{<p9> Y}}",  ];
c10:p9:e -> c13:p8:w [color="black", fontcolor="black", label=""];

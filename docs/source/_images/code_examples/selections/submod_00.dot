digraph "memdemo" {
label="memdemo";
rankdir="LR";
remincross=true;
n2 [ shape=diamond, label="mem[1]", color="black", fontcolor="black"];
n4 [ shape=diamond, label="mem[3]", color="black", fontcolor="black"];
n5 [ shape=diamond, label="mem[0]", color="black", fontcolor="black"];
n6 [ shape=diamond, label="mem[2]", color="black", fontcolor="black"];
n9 [ shape=octagon, label="clk", color="black", fontcolor="black"];
n10 [ shape=octagon, label="d", color="black", fontcolor="black"];
n11 [ shape=diamond, label="s1", color="black", fontcolor="black"];
n12 [ shape=diamond, label="s2", color="black", fontcolor="black"];
n13 [ shape=octagon, label="y", color="black", fontcolor="black"];
c16 [ shape=record, label="{{<p10> d|<p11> s1|<p12> s2}|selstage\nselstage|{<p14> n1|<p15> n2}}",  ];
c17 [ shape=record, label="{{<p9> clk|<p5> mem[0]|<p2> mem[1]|<p6> mem[2]|<p4> mem[3]|<p14> n1}|outstage\noutstage|{<p13> y}}",  ];
c21 [ shape=record, label="{{<p18> CLK|<p19> D}|$37\n$dff|{<p20> Q}}",  ];
c22 [ shape=record, label="{{<p18> CLK|<p19> D}|$38\n$dff|{<p20> Q}}",  ];
c23 [ shape=record, label="{{<p9> clk|<p10> d|<p14> n1}|scramble\nscramble|{<p5> mem[0]|<p2> mem[1]|<p6> mem[2]|<p4> mem[3]}}",  ];
n1 [ shape=point ];
c16:p14:e -> n1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];

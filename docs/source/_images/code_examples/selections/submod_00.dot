c17:p13:e -> n13:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c23:p2:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c17:p2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3 [ shape=point ];
c16:p15:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c21:p19:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c23:p14:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];

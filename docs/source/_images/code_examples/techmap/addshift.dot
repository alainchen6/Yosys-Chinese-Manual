digraph "test" {
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="Y", color="black", fontcolor="black"];
n2 [ shape=octagon, label="X", color="black", fontcolor="black"];
n3 [ shape=octagon, label="B", color="black", fontcolor="black"];
n4 [ shape=octagon, label="A", color="black", fontcolor="black"];
v0 [ label="1" ];
c5 [ shape=record, label="{{<p4> A|<p3> B}|$4\n$shl|{<p1> Y}}",  ];
c6 [ shape=record, label="{{<p4> A|<p3> B}|$1\n$add|{<p1> Y}}",  ];
c5:p1:e -> n1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c6:p1:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c6:p3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c5:p4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c6:p4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
v0:e -> c5:p3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
